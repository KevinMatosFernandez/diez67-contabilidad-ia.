const MONTHS: Record<string, string> = {
  enero: "01", febrero: "02", marzo: "03", abril: "04", mayo: "05",
  junio: "06", julio: "07", agosto: "08", septiembre: "09", setiembre: "09",
  octubre: "10", noviembre: "11", diciembre: "12",
};

type TelegramMessage = {
  message_id?: number;
  chat?: { id: number };
  from?: { id?: number; is_bot?: boolean };
  text?: string;
  caption?: string;
  document?: { file_id: string; file_name?: string; file_size?: number; mime_type?: string };
};

function jsonResponse(body: unknown, status = 200): Response {
  return new Response(JSON.stringify(body), { status, headers: { "Content-Type": "application/json" } });
}

function normalizeHeader(value: unknown): string {
  return String(value ?? "")
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .toLowerCase().replace(/\s+/g, " ").trim()
    .replace(/[._]/g, "");
}

function parseNumber(value: unknown): number | null {
  if (value === null || value === undefined || value === "") return null;
  if (typeof value === "number") return Number.isFinite(value) ? value : null;
  let s = String(value).trim().replace(/\s/g, "").replace(/[%$€₱]/g, "");
  if (!s || s === "-" || s.toLowerCase() === "n/a") return null;
  // Excel normally supplies numeric cells as numbers. For text cells, support common decimal formats.
  if (s.includes(",") && s.includes(".")) {
    if (s.lastIndexOf(",") > s.lastIndexOf(".")) s = s.replace(/\./g, "").replace(",", ".");
    else s = s.replace(/,/g, "");
  } else if (s.includes(",")) {
    const parts = s.split(",");
    s = parts.length === 2 && parts[1].length !== 3 ? `${parts[0]}.${parts[1]}` : s.replace(/,/g, "");
  }
  const n = Number(s);
  return Number.isFinite(n) ? n : null;
}

function parsePeriod(fileName: string): { start: string; end: string } | null {
  const clean = fileName.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  const match = clean.match(/(?:^|\D)(\d{1,2})(?:\s*[-–]\s*(\d{1,2}))?\s+(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)\s+(20\d{2})(?:\D|$)/i);
  if (!match) return null;
  const firstDay = Number(match[1]);
  const lastDay = Number(match[2] || match[1]);
  const month = MONTHS[match[3]];
  const year = Number(match[4]);
  const validDate = (day: number) => {
    const d = new Date(Date.UTC(year, Number(month) - 1, day));
    return d.getUTCFullYear() === year && d.getUTCMonth() === Number(month) - 1 && d.getUTCDate() === day;
  };
  if (!validDate(firstDay) || !validDate(lastDay) || lastDay < firstDay) return null;
  return { start: `${year}-${month}-${String(firstDay).padStart(2, "0")}`, end: `${year}-${month}-${String(lastDay).padStart(2, "0")}` };
}

function valueAt(row: unknown[], headerIndexes: Map<string, number>, aliases: string[]): unknown {
  for (const alias of aliases) {
    const index = headerIndexes.get(normalizeHeader(alias));
    if (index !== undefined) return row[index];
  }
  return null;
}

function originalCells(headers: unknown[], row: unknown[]): Array<{ columna: string; encabezado: string; valor: unknown }> {
  return headers.map((header, index) => ({
    columna: XLSX.utils.encode_col(index),
    encabezado: String(header ?? "").trim() || `(sin encabezado ${XLSX.utils.encode_col(index)})`,
    valor: row[index] === undefined ? null : row[index],
  })).filter((cell) => cell.valor !== null && cell.valor !== "" && cell.encabezado !== "");
}

function mapExcelRow(headers: unknown[], row: unknown[], period: { start: string; end: string }, fileName: string) {
  const index = new Map<string, number>();
  headers.forEach((h, i) => {
    const key = normalizeHeader(h);
    if (key && !index.has(key)) index.set(key, i);
  });
  const productRaw = valueAt(row, index, ["Producto", "Nombre del producto", "Artículo", "Articulo"]);
  const producto = String(productRaw ?? "").trim();
  if (!producto) return null;

  const numeric = (aliases: string[]) => parseNumber(valueAt(row, index, aliases));
  return {
    fecha: period.end,
    fecha_inicio: period.start,
    fecha_fin: period.end,
    producto,
    inicio: numeric(["Inicio", "Inventario inicial"]),
    entrada: numeric(["Entrada", "Entradas"]),
    rotura: numeric(["Rotura", "Roturas"]),
    consumo: numeric(["Consumo", "Consumo interno"]),
    disponible: numeric(["Disponible", "Existencia disponible"]),
    final: numeric(["Final", "Inventario final"]),
    precio: numeric(["Precio"]),
    precio_sug_30_cup: numeric(["Precio sug 30% CUP", "Precio sugerido 30% CUP"]),
    precio_usd: numeric(["Precio/usd", "Precio USD"]),
    precio_sug_30_usd: numeric(["Precio sug 30%", "Precio sug 30% USD", "Precio sugerido 30% USD"]),
    venta: numeric(["Venta", "Unidades vendidas"]),
    importe: numeric(["Importe", "Importe CUP"]),
    importe_usd: numeric(["Importe/usd", "Importe USD"]),
    costo: numeric(["Costo", "Costo unitario"]),
    costo_usd: numeric(["Costo/usd", "Costo USD"]),
    importe_costo: numeric(["Importe Costo", "Costo total CUP"]),
    importe_costo_usd: numeric(["Importe Costo/usd", "Importe Costo USD"]),
    ganancias: numeric(["Ganancias", "Ganancia"]),
    ganancias_usd: numeric(["Ganancias/usd", "Ganancia USD"]),
    margen_pct: numeric(["Margen (%)", "Margen %", "Margen"]),
    tasa_ref: numeric(["Tasa Ref", "Tasa de referencia", "Tasa"]),
    costo_rotura: null,
    costo_consumo: null,
    datos_originales: originalCells(headers, row),
    archivo_origen: fileName,
  };
}

async function telegramRequest(token: string, method: string, body?: unknown): Promise<any> {
  const response = await fetch(`${TELEGRAM_API}/bot${token}/${method}`, {
    method: body === undefined ? "GET" : "POST",
    headers: body === undefined ? undefined : { "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  const data = await response.json().catch(() => null);
  if (!response.ok || !data?.ok) throw new Error(`Telegram ${method} falló (HTTP ${response.status}).`);
  return data.result;
}

async function sendTelegram(token: string, chatId: number, text: string): Promise<void> {
  // Telegram message limit is 4096 characters; leave room for safety.
  const chunks: string[] = [];
  for (let i = 0; i < text.length; i += 3900) chunks.push(text.slice(i, i + 3900));
  for (const chunk of (chunks.length ? chunks : ["No se generó respuesta."])) {
    await telegramRequest(token, "sendMessage", { chat_id: chatId, text: chunk, disable_web_page_preview: true });
  }
}

function supabaseHeaders(apiKey: string, prefer?: string): HeadersInit {
  const headers: Record<string, string> = {
    apikey: apiKey,
    Authorization: `Bearer ${apiKey}`,
    "Content-Type": "application/json",
  };
  if (prefer) headers.Prefer = prefer;
  return headers;
}

async function importExcel( token: string, apiKey: string, projectUrl: string, document: NonNullable<TelegramMessage["document"]>, ): Promise<string> {
  const fileName = document.file_name || "archivo.xlsx";
  if (!/\.xlsx$/i.test(fileName)) return "No pude importar el archivo: debe ser un Excel .xlsx. Guarda o envía el archivo en formato .xlsx e inténtalo de nuevo.";
  if (document.file_size && document.file_size > MAX_FILE_BYTES) return "El archivo supera el límite de 15 MB. Divide el archivo o envía una versión más pequeña.";
  const period = parsePeriod(fileName);
  if (!period) return "No pude identificar el período en el nombre del archivo. Usa un nombre como: `Ventas 1 octubre 2026.xlsx` o `Ventas 1-2 octubre 2026.xlsx`. No se importó nada.";

  // Prevent a second import of the same date range. The unique constraint is an additional safeguard.
  const duplicateUrl = new URL(`${projectUrl}/rest/v1/registros_excel_diario`);
  duplicateUrl.searchParams.set("select", "id");
  duplicateUrl.searchParams.set("fecha_inicio", `eq.${period.start}`);
  duplicateUrl.searchParams.set("fecha_fin", `eq.${period.end}`);
  duplicateUrl.searchParams.set("limit", "1");
  const duplicateResponse = await fetch(duplicateUrl, { headers: supabaseHeaders(apiKey) });
  if (!duplicateResponse.ok) throw new Error("No pude comprobar si el período ya está importado. No se importó el archivo.");
  const duplicates = await duplicateResponse.json();
  if (Array.isArray(duplicates) && duplicates.length > 0) {
    return `El período ${period.start} a ${period.end} ya tiene registros en la base de datos. Para evitar duplicados, no importé el archivo. Si necesitas reemplazarlo, primero hay que definir un procedimiento seguro para corregir esa importación.`;
  }

  const fileInfo = await telegramRequest(token, "getFile", { file_id: document.file_id });
  if (!fileInfo?.file_path) throw new Error("Telegram no proporcionó la ruta de descarga del archivo.");
  const downloadResponse = await fetch(`${TELEGRAM_API}/file/bot${token}/${fileInfo.file_path}`);
  if (!downloadResponse.ok) throw new Error("No pude descargar el Excel desde Telegram.");
  const bytes = new Uint8Array(await downloadResponse.arrayBuffer());
  if (bytes.byteLength > MAX_FILE_BYTES) return "El archivo supera el límite de 15 MB. No se importó nada.";

  let workbook: XLSX.WorkBook;
  try {
    workbook = XLSX.read(bytes, { type: "array", cellDates: false });
  } catch {
    return "No pude leer el archivo. Comprueba que sea un Excel .xlsx válido y vuelve a enviarlo.";
  }
  if (workbook.SheetNames.length !== 1) {
    return `El archivo tiene ${workbook.SheetNames.length} hojas. Para evitar mezclar días o importar información equivocada, envía un archivo .xlsx con una sola hoja correspondiente al período indicado en el nombre.`;
  }
  const sheet = workbook.Sheets[workbook.SheetNames[0]];
  const matrix = XLSX.utils.sheet_to_json<unknown[]>(sheet, { header: 1, defval: null, raw: true, blankrows: false });
  if (matrix.length < 2) return "La hoja está vacía o solo contiene encabezados. No se importó nada.";
  const headers = matrix[0].map((h) => h ?? "");
  const headerMap = new Set(headers.map(normalizeHeader));
  if (!headerMap.has("producto")) return "No encontré una columna `Producto` en la primera fila. No se importó nada.";

  const rows = matrix.slice(1);
  const records = rows.map((row) => mapExcelRow(headers, row, period, fileName)).filter((r): r is NonNullable<typeof r> => r !== null);
  if (records.length === 0) return "No encontré filas con productos válidos. No se importó nada.";

  const seen = new Set<string>();
  const repeated: string[] = [];
  for (const record of records) {
    const key = record.producto.trim().toLocaleLowerCase("es");
    if (seen.has(key)) repeated.push(record.producto);
    seen.add(key);
  }
  if (repeated.length) {
    return `Detecté productos repetidos en la misma hoja (${[...new Set(repeated)].slice(0, 10).join(", ")}). No importé nada para evitar duplicados. Revisa el Excel y vuelve a enviarlo.`;
  }

  // One insert request keeps this import all-or-nothing from the application's perspective.
  const insertResponse = await fetch(`${projectUrl}/rest/v1/registros_excel_diario`, {
    method: "POST",
    headers: supabaseHeaders(apiKey, "return=representation"),
    body: JSON.stringify(records),
  });
  const responseText = await insertResponse.text();
  if (!insertResponse.ok) {
    // Do not expose database details or credentials to Telegram.
    if (insertResponse.status === 409 || responseText.includes("23505")) {
      return "La base de datos detectó registros duplicados para ese período/producto y rechazó la importación. No vuelvas a enviarlo por ahora; hay que revisar si ya existía una importación.";
    }
    console.error("Supabase insert error", insertResponse.status, responseText.slice(0, 1000));
    return "Supabase rechazó la importación. No puedo confirmar que se hayan guardado los registros. No vuelvas a enviar el archivo hasta revisar el estado en la base de datos.";
  }
  let inserted: unknown = null;
  try { inserted = responseText ? JSON.parse(responseText) : null; } catch { inserted = null; }
  const insertedCount = Array.isArray(inserted) ? inserted.length : records.length;
  if (insertedCount !== records.length) {
    return `Supabase respondió a la importación, pero el número confirmado (${insertedCount}) no coincide con las filas preparadas (${records.length}). Revisa la tabla antes de volver a importar.`;
  }
  const consumptionColumnPresent = headers.some((h) => normalizeHeader(h) === "consumo");
  const rateCount = records.filter((r) => r.tasa_ref !== null).length;
  return `Importación confirmada.\n\nArchivo: ${fileName}\nPeríodo: ${period.start} a ${period.end}\nHoja: ${workbook.SheetNames[0]}\nProductos guardados: ${insertedCount}\n\nNotas de control:\n- Los datos originales se conservaron por columna, incluyendo columnas auxiliares con encabezados repetidos.\n- ${consumptionColumnPresent ? "La hoja contiene la columna Consumo; se importaron sus valores disponibles." : "La hoja no contiene columna Consumo; ese campo quedó vacío y no se inventaron cantidades."}\n- La tasa de referencia aparece en ${rateCount} fila(s); solo se guardó donde el Excel tenía un valor. No se copió a otras filas.\n- No se modificó inventario ni se crearon asientos contables; solo se guardó el registro importado.`;
}

async function answerQuestion( apiKey: string, projectUrl: string, userText: string, ): Promise<string> {
  const queryUrl = new URL(`${projectUrl}/rest/v1/registros_excel_diario`);
  queryUrl.searchParams.set("select", "fecha,fecha_inicio,fecha_fin,producto,inicio,entrada,rotura,consumo,disponible,final,venta,importe,importe_usd,costo,costo_usd,importe_costo,importe_costo_usd,ganancias,ganancias_usd,margen_pct,tasa_ref,archivo_origen");
  queryUrl.searchParams.set("order", "fecha.desc,producto.asc");
  queryUrl.searchParams.set("limit", "500");
  const dbResponse = await fetch(queryUrl, { headers: supabaseHeaders(apiKey) });
  if (!dbResponse.ok) {
    console.error("Supabase read error", dbResponse.status, (await dbResponse.text()).slice(0, 1000));
    return "No pude consultar la base de datos en este momento, así que no puedo verificar las cifras. Inténtalo de nuevo más tarde.";
  }
  const records = await dbResponse.json();
  const dataContext = Array.isArray(records) && records.length
    ? JSON.stringify({ registros_recientes: records, cantidad_registros_entregados: records.length, limite_consulta: 500 })
    : "No hay registros disponibles en la consulta actual de registros_excel_diario.";
  const prompt = `${SYSTEM_PROMPT}\n\nCONTEXTO REAL DE LA BASE DE DATOS (consulta actual; no inventes registros):\n${dataContext}\n\nPREGUNTA DEL USUARIO:\n${userText}`;
  const geminiResponse = await fetch(`${GEMINI_API}?key=${encodeURIComponent(apiKey)}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ contents: [{ role: "user", parts: [{ text: prompt }] }], generationConfig: { temperature: 0.2, maxOutputTokens: 2048 } }),
  });
  if (!geminiResponse.ok) {
    const detail = await geminiResponse.text();
    console.error("Gemini error", geminiResponse.status, detail.slice(0, 1000));
    return "No pude generar la respuesta con la IA en este momento. Los datos de la base de datos no se han modificado. Inténtalo de nuevo más tarde.";
  }
  const result = await geminiResponse.json();
  const answer = result?.candidates?.[0]?.content?.parts?.map((p: { text?: string }) => p.text || "").join("").trim();
  return answer || "La IA no devolvió una respuesta utilizable. Inténtalo de nuevo con una pregunta más concreta.";
}


Deno.serve(async (req: Request) => {
  if (req.method !== "POST") return jsonResponse({ ok: true, message: "DIEZ67 Contable está activo." });

  const telegramToken = Deno.env.get("TELEGRAM_BOT_TOKEN");
  const geminiKey = Deno.env.get("GEMINI_API_KEY") || "";
  const webhookSecret = Deno.env.get("TELEGRAM_WEBHOOK_SECRET");
  const ownerId = Deno.env.get("TELEGRAM_OWNER_ID");
  const projectUrl = (Deno.env.get("PROJECT_URL") || Deno.env.get("SUPABASE_URL") || "").replace(/\/$/, "");
  const databaseKey = Deno.env.get("DATABASE_API_KEY");

  if (!telegramToken || !geminiKey || !ownerId || !projectUrl || !databaseKey) {
    console.error("Missing required Supabase secrets: TELEGRAM_BOT_TOKEN, GEMINI_API_KEY, TELEGRAM_OWNER_ID, PROJECT_URL/SUPABASE_URL, DATABASE_API_KEY.");
    return jsonResponse({ ok: false, error: "Faltan secretos de configuración." }, 500);
  }
  if (webhookSecret && req.headers.get("x-telegram-bot-api-secret-token") !== webhookSecret) {
    return jsonResponse({ ok: false, error: "Unauthorized" }, 401);
  }

  let update: { message?: TelegramMessage };
  try { update = await req.json(); }
  catch { return jsonResponse({ ok: true, ignored: true }); }

  const message = update?.message;
  const chatId = message?.chat?.id;
  const userId = message?.from?.id;
  if (!message || !chatId || !userId || message.from?.is_bot || String(userId) !== ownerId) {
    return jsonResponse({ ok: true, ignored: true });
  }

  try {
    if (message.document) {
      const result = await importExcel(telegramToken, databaseKey, projectUrl, message.document);
      await sendTelegram(telegramToken, chatId, result);
      return jsonResponse({ ok: true });
    }
    const userText = (message.text || message.caption || "").trim();
    if (!userText) {
      await sendTelegram(telegramToken, chatId, "Envíame una pregunta escrita o un archivo Excel .xlsx con el período en el nombre, por ejemplo: Ventas 1 octubre 2026.xlsx.");
      return jsonResponse({ ok: true });
    }
    const answer = await answerQuestion(geminiKey, projectUrl, userText);
    await sendTelegram(telegramToken, chatId, answer);
    return jsonResponse({ ok: true });
  } catch (error) {
    console.error("DIEZ67 Contable error", error instanceof Error ? error.message : String(error));
    try { await sendTelegram(telegramToken, chatId, "Ocurrió un error técnico y no pude completar la operación. No vuelvas a enviar el Excel todavía; primero hay que verificar si la base de datos guardó algo."); } catch { /* webhook response still returns */ }
    return jsonResponse({ ok: true });
  }
});
